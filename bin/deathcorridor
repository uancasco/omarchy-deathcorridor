def term_program(pid, kids):
    """First 'real' program under a terminal (skipping shells and helpers): claude, nvim, btop..."""
    queue = [pid]
    while queue:
        nxt = []
        for p in queue:
            for cp, comm, args in kids.get(p, []):
                if "<defunct>" in args: continue
                txt = (comm + " " + args).lower()
                for k, v in KNOWN.items():
                    if comm.lower() == k or f"/{k} " in txt + " " or txt.startswith(k + " "): return v
                if comm not in SHELLS and not comm.startswith("kitten"): return comm
                nxt.append(cp)
        queue = nxt
    return None

def friendly_name(cls, pid, kids):
    c = cls.lower()
    if c.startswith("chrome-"):
        host = c[7:].split("__")[0].replace("www.", "")
        return WEBAPPS.get(host, host) + " (web app)"
    if c == "google-chrome": return "Google Chrome"
    if any(c == t or c.startswith(t) for t in TERMINALS):
        prog = term_program(pid, kids)
        return f"Terminal › {prog}" if prog else "Terminal"
    if c.startswith("org.") or "." in c: return c.split(".")[-1].replace("_", " ")
    return cls[:1].upper() + cls[1:] if cls.islower() else cls

