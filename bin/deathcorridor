#!/usr/bin/env python3
"""deathcorridor: live task manager for Hyprland, three views (Tab switches).
  Apps       open windows grouped by workspace (real audio meter per app) + apps living in the background
  Processes  every process of yours, sortable by CPU / memory / GPU / name / PID, optionally grouped by name
  JAIL       (F2) what needs fixing: an app not responding, or one that keeps crashing. Enter = the AI looks into it and fixes it (asking first)
Keys (both views): Up/Down move · Tab switch view · Del end task
  w           follow the picked program (◉): records what happens to it, shows in JAIL, checks the fix
  Both:       Ctrl+F (or /) to search (Apps: name/title · Processes: name/PID) · Enter/arrows leave the search · Ctrl+U clear · Esc clears the search, then quits
  Apps:       Enter go to window · c close window (SIGTERM for background apps) · x end task
  Processes:  Left/Right sort column · Ctrl+R reverse · Ctrl+G group by name"""
import os
os.environ.setdefault("ESCDELAY", "15")   # Esc without delay (curses waits 1s by default)
import curses, json, subprocess, struct, threading, time, math, zlib, signal, re, glob, configparser
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))          # find deathcorridor_report.py next to this script, however it is launched
import deathcorridor_report as RP
import deathcorridor_watch as WT
import deathcorridor_private as PV
import deathcorridor_keys as KY
PV.tighten(RP.STATE_DIR); PV.tighten(os.path.dirname(RP.CONFIG))      # anything stored by an older version gets owner-only permissions

RATE, CHUNK_MS = 8000, 40
level_by_bin, lock, seen = {}, threading.Lock(), set()   # level_by_bin[binary] = (peak 0..1, timestamp)
ME = os.getuid()
NCPU = os.cpu_count() or 1

def sh(*a):
    return subprocess.run(a, capture_output=True).stdout.decode("utf-8", "replace")

# ---------------------------------------------------------------- audio meter

def reader(idx, sink, binary):
    size = RATE * 2 * CHUNK_MS // 1000
    p = subprocess.Popen(["parec", f"--monitor-stream={idx}", "-d", sink + ".monitor", "--format=s16le",
                          f"--rate={RATE}", "--channels=1", "--latency-msec=20"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        while True:
            d = p.stdout.read(size)
            if len(d) < size: break
            v = struct.unpack(f"<{len(d)//2}h", d)
            peak = max(abs(x) for x in v) / 32768
            with lock:
                level_by_bin[binary] = (peak, time.time())
    finally:
        p.kill()
        with lock: seen.discard(idx)

def watch_audio():
    while True:
        try:
            sinks = {s["index"]: s["name"] for s in json.loads(sh("pactl", "-f", "json", "list", "sinks") or "[]")}
            for s in json.loads(sh("pactl", "-f", "json", "list", "sink-inputs") or "[]"):
                if s.get("corked") or s["index"] in seen or s["sink"] not in sinks: continue
                pr = s["properties"]
                b = (pr.get("application.process.binary") or pr.get("application.name") or "").lower()
                with lock: seen.add(s["index"])
                threading.Thread(target=reader, args=(s["index"], sinks[s["sink"]], b), daemon=True).start()
        except Exception:
            pass
        time.sleep(1)

def mpris_titles():
    """Titles of what is playing (MPRIS): Chrome shares one process across all its windows; this tells which one is playing."""
    out = []
    for n in sh("busctl", "--user", "list", "--no-legend").splitlines():
        n = n.split()[0] if n.split() else ""
        if not n.startswith("org.mpris.MediaPlayer2."): continue
        a = ("--user", "--json=short", "get-property", n, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player")
        try:
            if json.loads(sh("busctl", *a, "PlaybackStatus"))["data"] != "Playing": continue
            t = json.loads(sh("busctl", *a, "Metadata"))["data"].get("xesam:title", {}).get("data", "")
            if t: out.append(t)
        except Exception: pass
    return out

